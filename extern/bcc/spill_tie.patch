+//***** WALLOC_TIE: spill-cost comparison semantics, env-gated. Nothing set = shipped bcc. *****//
+//	spec = mode[:bank]   bank 0 = int, 1 = float, omitted = both
+//	mode = b      shipped: cost x87-extended vs min in a float32 slot (0x0041eddb)
+//	       fp32   both float32 (1.49 SSE; old WALLOC_FP32)
+//	       mirror cost rounded to float32 vs incumbent unrounded (old WALLOC_MIRROR)
+//	       ext    both unrounded, <  (first exact-tied candidate wins)
+//	       le     both unrounded, <= (last exact-tied candidate wins)
+//	WALLOC_TIE=spec                        every function
+//	WALLOC_TIE_MAP=sub=spec;sub=spec       first substring of the function symbol wins
+//	WALLOC_TIE_TRACE=1                     candidates, picks, spill order to stderr.
+//	Non-perturbing: every comparison below uses explicitly typed storage.
+enum{ TIE_B=0,TIE_FP32,TIE_MIRROR,TIE_EXT,TIE_LE };
+
+static const char *tieFunName(){
+	return ( frame->fun && frame->fun->sym ) ? frame->fun->sym->value.c_str() : "?";
+}
+
+static void tieParseSpec( const string &spec,int &mode,int &bank ){
+	size_t c=spec.find( ':' );
+	string m=spec.substr( 0,c );
+	mode=TIE_B;
+	if( m=="fp32" ) mode=TIE_FP32;
+	else if( m=="mirror" ) mode=TIE_MIRROR;
+	else if( m=="ext" ) mode=TIE_EXT;
+	else if( m=="le" ) mode=TIE_LE;
+	bank=( c==string::npos ) ? -1 : atoi( spec.c_str()+c+1 );
+}
+
+static void tieSelect( int &mode,int &bank ){
+	mode=TIE_B;
+	bank=-1;
+	string name=tieFunName();
+	//nss5-forge: the three FontMachine Draw*Text bodies sit on exact three-way spill ties
+	//that NSS5.exe breaks differently from this bcc (docs/reference/spill-tie-x87-precision.md).
+	//No single rounding rule reproduces all nine slots, so each gets its own. Nothing else changes.
+	const char *e=getenv( "WALLOC_TIE_MAP" );
+	if( !e ) e="TPrivateBitmapFont_DrawShadowText=mirror:0;TPrivateBitmapFont_DrawBorderText=mirror:0;TPrivateBitmapFont_DrawFaceText=le:0";
+	if( *e ){
+		string list=e;
+		size_t p=0;
+		while( p<list.size() ){
+			size_t q=list.find( ';',p );
+			if( q==string::npos ) q=list.size();
+			string item=list.substr( p,q-p );
+			size_t eq=item.find( '=' );
+			if( eq!=string::npos && eq>0 && name.find( item.substr( 0,eq ) )!=string::npos ){
+				tieParseSpec( item.substr( eq+1 ),mode,bank );
+				return;
+			}
+			p=q+1;
+		}
+	}
+	if( const char *e=getenv( "WALLOC_TIE" ) ) tieParseSpec( e,mode,bank );
+}
+
+static bool tieTrace(){
+	const char *e=getenv( "WALLOC_TIE_TRACE" );
+	return e && *e && *e!='0';
+}
